# Copy to .env for local runs. Never commit .env.
# Values that still look like these samples are treated as "not configured":
# the server starts, /ready lists them, and the matching pages show a banner.

PORT=3000
APP_URL=http://localhost:3000

# Supabase -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Stripe -> Developers -> Webhooks -> endpoint <APP_URL>/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
# Stripe -> Products -> each recurring price
STRIPE_STARTER_PRICE_ID=price_your_starter_price
STRIPE_PRO_PRICE_ID=price_your_pro_price
STRIPE_FAMILY_PRICE_ID=price_your_family_price
