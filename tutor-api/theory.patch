+/* מה שעל המסך: השאלה של מסך הרצף, או של תרגול. בבחינה — כלום:
+   שם אין רמזים, ואין למורה מה לומר לפני שהמבחן נגמר. */
+function barakQ(){
+  if(S.screen === 'flow') return FLOW.q ? { raw: FLOW.q, q: FLOW.q.q, o: FLOW.q.o || [], c: FLOW.q.c, h1: FLOW.q.h1, h2: FLOW.q.h2 } : null;
+  if(S.screen === 'practice' && S.deck.length){
+    const p = P(), d = PT();
+    return { raw: p, q: d.q, o: d.o || [], c: p.c, h1: d.h1, h2: d.h2 };
+  }
+  return null;
+}
+if(window.TUTOR){
+  TUTOR.mount({
+    app: 'theory',
+    lang: () => S.lang,
+    q: () => {
+      const x = barakQ(); if(!x) return null;
+      return { expr: x.q, ans: x.o[x.c] || null, topic: x.raw.cat ? catLabel(x.raw.cat) : null, level: t('app') };
+    },
+    stopHost: () => { try{ stopSpeech(); }catch(e){} }
+  });
+}
+if(window.BARAK) BARAK.register({
+  app: 'theory',
+  getScreenContext: () => {
+    const x = barakQ(); if(!x) return null;
+    const picked = [...screen.querySelectorAll('.opt.almost span')].map(e => e.textContent.trim());
+    return {
+      id: (S.screen === 'flow' ? 'f' : 'p' + S.qi) + '-' + (x.raw.id || x.q.slice(0, 30)),
+      type: S.answered ? 'reveal' : 'mcq',
+      q: x.q, options: x.o.map(String), correct: x.o[x.c] || null,
+      student: picked.length ? picked[picked.length - 1] : null,
+      topic: x.raw.cat ? catLabel(x.raw.cat) : null, level: t('app'),
