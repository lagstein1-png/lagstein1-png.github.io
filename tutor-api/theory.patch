+      const before = S.hint;
+      S.screen === 'flow' ? flowHint(S.hint + 1) : showHint(S.hint + 1, true);
+      return S.hint > before;
+    } },
+    read_aloud: { desc: 'מקריא את השאלה ואת האפשרויות', run: () => {
+      const x = barakQ(); if(!x) return false;
+      stopSpeech(); speakQuestion(x.q, x.o); return true;
+    } },
+    repeat_question: { desc: 'מקריא שוב את השאלה', run: () => {
+      const x = barakQ(); if(!x) return false;
+      stopSpeech(); speakQuestion(x.q, x.o); return true;
+    } },
+    highlight_option: { desc: 'מדגיש במסך אחת מהאפשרויות לפי מקומה (0 עד 3)',
+      params: { index: { type: 'integer', min: 0, max: 3, required: true } },
+      run: (a) => {
+        const x = barakQ(); if(!x || S.answered) return false;
+        const btns = screen.querySelectorAll('.opt');
+        return BARAK.highlight(btns[a.index] || null);
+      } },
+    show_sign_image: { desc: 'מציג ומדגיש את התמרור או התמונה של השאלה', run: () => {
+      const x = barakQ(); if(!x) return false;
+      const st = el('stage'); if(!st || !st.firstElementChild) return false;
+      return BARAK.highlight(st);
+    } },
+    go_screen: { desc: 'עובר למסך אחר של האפליקציה',
+      params: { name: { type: 'string', enum: ['home', 'flow', 'practice', 'exam', 'mistakes', 'tracker', 'settings'], required: true } },
+      run: (a) => { go(a.name); return S.screen === a.name; } }
+  }
+});
 })();
