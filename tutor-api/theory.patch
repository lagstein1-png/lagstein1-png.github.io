+      const nb = el('btnNextQ');
+      if(nb){ nb.click(); return true; }
+      const sb = el('btnSkip');
+      if(sb){ sb.click(); return true; }
+      return false;
+    } },
+    show_hint: { desc: 'מציג את הרמז הבא לשאלה', run: () => {
